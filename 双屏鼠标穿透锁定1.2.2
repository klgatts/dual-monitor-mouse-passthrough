; ============ 17. 配置模板（首次运行生成） ============
EnsureIniHeader() {
    global CONFIG
    if !FileExist(CONFIG) {
        f := FileOpen(CONFIG, "w", "UTF-16") ; 全新: 生成带注释模板
        f.Write("; 双屏鼠标穿透锁定 配置文件`n`n"
            . "[设置]`n"
            . "; 主屏幕(穿透锁定基准屏), 托盘右键可切换`n"
            . "; primaryRes=主屏分辨率(宽x高), 便携屏插拔/设备名变更后靠它找回主屏`n"
            . "primaryMonitor=`n"
            . "primaryRes=`n"
            . "; 锁定模式 1=只锁主屏 2=主副屏单独锁(托盘可切换)`n"
            . "lockMode=1`n"
            . "; 操作提示气泡 1=显示 0=关闭`n"
            . "showTips=1`n"
            . "; 快捷键判定时间(毫秒): 单击/双击共用, 长按自动+30ms, 最低150`n"
            . "judgeMs=400`n`n"
            . "[热键]`n"
            . "; 穿透快捷键: 单击=解锁/锁定 双击=播放/暂停副屏 长按=发送副屏按键`n"
            . "穿透=LCtrl+Num*`n"
            . "; 暂停/恢复(鼠标完全自由)快捷键`n"
            . "暂停=LCtrl+Num/`n"
            . "; 长按穿透键发送到副屏最顶层窗口的按键, 默认 LShift+Win+Left（把副屏最顶层窗口快速移到主屏）`n"
            . "; 快捷键支持鼠标键: 鼠标中键=中键 鼠标侧键1/2=侧键`n"
            . "secKey=LShift+Win+Left`n")
        f.Close()
        return
    }
    c := FileRead(CONFIG)
    if InStr(c, "双屏鼠标穿透锁定")
        return
    head := "; 双屏鼠标穿透锁定 配置文件`n`n"
    f := FileOpen(CONFIG, "w", "UTF-16")     ; UTF-16: AHK IniWrite 追加时保持同编码, 中文不乱码
    f.Write(head . c)
    f.Close()
}

; ============ 18. 启动流程 ============
; 按当前主屏重算锁定区域
RefreshMonitors()

; 读快捷键：兼容老写法，统一存成好读的格式
hkUnlock := AhkFromDisplay(IniRead(CONFIG, "热键", "穿透", "^NumpadMult"))
hkPause := AhkFromDisplay(IniRead(CONFIG, "热键", "暂停", "^NumpadDiv"))
if IniRead(CONFIG, "热键", "穿透", "") != DisplayHotkey(hkUnlock)
    IniWrite(DisplayHotkey(hkUnlock), CONFIG, "热键", "穿透")
if IniRead(CONFIG, "热键", "暂停", "") != DisplayHotkey(hkPause)
    IniWrite(DisplayHotkey(hkPause), CONFIG, "热键", "暂停")
; 注册快捷键，配置坏了就退回默认键
try
    RegisterHotkeys(hkUnlock, hkPause)
catch
    RegisterHotkeys("^NumpadMult", "^NumpadDiv")
SetTimer(LockCheck, POLL_MS)

; 建托盘菜单（热键注册好后再建，菜单上直接显示当前按键）
BuildTrayMenu()
